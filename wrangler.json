{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chongqi-commerce",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chongqi-commerce-db",
      "database_id": "9dcc6c58-2943-4c7e-9dec-c80dabf415f5",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "DEMO_MODE": "false",
    "TRON_RECEIVING_ADDRESS": "TPoB2HAiDwytbiVFoFQHh7h8cUwo9zDg6Y",
    "USDT_CNY_RATE": "6.6"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "keep_vars": true
}
